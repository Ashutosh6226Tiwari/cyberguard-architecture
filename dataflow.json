  "cards": [
    {
      "dot": "emerald",
      "title": "On-Device Data Boundary",
      "items": [
        "Full unredacted URLs, query parameters, auth tokens, and paths remain exclusively in volatile memory",
        "Target web pages are NEVER contacted or downloaded (zero-fetch guarantee)",
        "LexicalAnalyzer processes Shannon entropy, brand homographs, and leet-speak entirely on-device"
      ]
    },
    {
      "dot": "rose",
      "title": "Off-Device Telemetry Boundary",
      "items": [
        "Only the isolated domain name (e.g. example.com) leaves the device",
        "Google DoH (dns.google) is queried for A, NS, MX, and TXT records over HTTPS",
        "ICANN RDAP (rdap.org) is queried solely for domain creation timestamp and registrar",
        "Zero personal identifiers, device IDs, IP addresses, or URL query parameters are transmitted"
      ]
    },
    {
      "dot": "cyan",
      "title": "Local Persistence & Sanitization",
      "items": [
        "UrlValidatorAndSanitizer strips userinfo, paths, queries, and fragments",
        "Room database (cyberguard_history.db) persists only sanitized scheme://host strings",
        "Storage is strictly capped at 200 entries with no cloud backup (allowBackup=false)"
      ]
    }
  ]
