  "cards": [
    {
      "dot": "cyan",
      "title": "Link Interception & Sanitization",
      "items": [
        "LinkCheckActivity registers for ACTION_VIEW and ACTION_SEND to intercept tapped links",
        "UrlValidatorAndSanitizer enforces 2048-char limits and blocks dangerous pseudo-schemes",
        "Volatile in-memory URL keeps destination query params while stripping credentials for storage"
      ]
    },
    {
      "dot": "emerald",
      "title": "Zero-Fetch Scan Engine",
      "items": [
        "Never loads, preloads, or executes code on the target web destination",
        "LexicalAnalyzer inspects 15 on-device heuristic signals including brand homographs",
        "NetworkLookups runs parallel queries to Google DoH and ICANN RDAP with 64 KB stream limits",
        "ScanScoringEngine maps signals to a 0–100 risk score and SAFE, SUSPICIOUS, or PHISHING verdict"
      ]
    },
    {
      "dot": "rose",
      "title": "Loop Prevention & Forwarding",
      "items": [
        "BrowserHelper enumerates system browsers and explicitly filters out CyberGuard",
        "Dispatches explicit intents to secondary browsers (Chrome, Firefox, Brave) on user confirmation",
        "Room database persists only redacted scheme://host records capped at 200 entries"
      ]
    }
  ]
